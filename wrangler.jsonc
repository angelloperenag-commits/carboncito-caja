// Cloudflare (Workers con archivos estáticos). Arriba va producción (rama main);
// el bloque "previews" es la vista previa de la rama pruebas, con su propia base de datos.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elcarboncito",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "carboncito", "database_id": "PENDIENTE-ID-PRODUCCION" }
  ],
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "carboncito-pruebas", "database_id": "PENDIENTE-ID-PRUEBAS" }
    ]
  }
}
